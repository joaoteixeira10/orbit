# Orbit v1 — environment for docker compose (docker-compose.yml /
# docker-compose-build.yml). Copy to .env and fill in the REQUIRED values.
# Every variable, with required / default: docs/CONFIGURATION.md.
# (The lab proxies keep their agent tokens in lab/<host>/.env.)

# --- Deployment image ---
# Image + tag docker-compose.yml runs. Pin a release for reproducible deploys;
# unset tracks :latest. Update with: docker compose pull && docker compose up -d
ORBIT_IMAGE=harbor.ubonito.org/proxy_manager/orbit
ORBIT_VERSION=v1.1.0
# Host port for the container's :8080.
ORBIT_PORT=8080

# --- Secrets (REQUIRED in release mode, >= 32 characters) ---
# Where the secrets (JWT_SECRET, ORBIT_MASTER_KEY, DB_URL, ADMIN_PASSWORD, the
# BACKUP_S3_* keys, AGENT_CLIENT_KEY) are read from — both ways stay supported:
# env (default: this file) | file (<KEY>_FILE, e.g. ORBIT_MASTER_KEY_FILE=/run/secrets/master_key)
# | vault (HashiCorp Vault KV v2: VAULT_ADDR, VAULT_KV_PATH, VAULT_KV_MOUNT=secret,
#   VAULT_TOKEN or VAULT_ROLE_ID/VAULT_SECRET_ID; read once at start-up)
SECRETS_BACKEND=env
# HMAC secret for the access tokens:  openssl rand -hex 32
JWT_SECRET=
# Key-encryption key sealing secrets at rest (TOTP secrets, the OIDC client
# secret, agent tokens):  openssl rand -hex 32
# Must stay STABLE — changing it makes the sealed secrets unreadable.
ORBIT_MASTER_KEY=

# --- First admin (first start only, empty database) ---
ADMIN_USER=admin
# Leave empty to get a random temporary password printed once in the log
# (docker compose logs api | grep -A1 "First sign-in"). Either way you choose
# a new one at first sign-in.
ADMIN_PASSWORD=

# --- HTTP ---
HTTP_ADDR=:8080
# debug | release | test  (release enforces the secrets above + Secure cookies)
GIN_MODE=release
# Optional HTTPS in the app itself (otherwise terminate TLS in a reverse proxy):
#   TLS_CERT_FILE=/certs/server.crt
#   TLS_KEY_FILE=/certs/server.key
# Auth cookies are Secure in release or with TLS; override only if needed:
#   COOKIE_SECURE=true
#   COOKIE_DOMAIN=example.org
# Reverse-proxy CIDRs whose X-Forwarded-For is trusted (rate limits + audit IPs).
# EMPTY = trust none (the socket peer), safe by default.
#   TRUSTED_PROXIES=10.0.0.0/8
TRUSTED_PROXIES=
# Max request body in bytes (default 4 MiB).
MAX_BODY_BYTES=4194304
# Dev only: origins of the Vite dev server.
CORS_ORIGINS=

# --- Database ---
# sqlite only for now (see docs/BLUEPRINT-FIT.md).
DB_DRIVER=sqlite
DB_URL=/data/orbit.db

# --- Sign-in hardening ---
# Per-IP throttle on sign-in and second-factor endpoints: bucket + refill/min.
AUTH_RATE_BURST=8
AUTH_RATE_PER_MINUTE=12
# Lock an account after N consecutive wrong passwords / codes, for M minutes.
# THRESHOLD=0 disables it (the per-IP throttle still applies).
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# --- Passkeys (WebAuthn) ---
# Empty RP ID disables passkeys (dev defaults to localhost). In production: the
# public host name users see, and its full origin(s). The RP ID is effectively
# permanent — changing it orphans registered passkeys.
#   WEBAUTHN_RP_ID=lb.example.org
#   WEBAUTHN_RP_ORIGINS=https://lb.example.org
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGINS=
WEBAUTHN_RP_DISPLAY_NAME=Orbit

# --- Proxies ---
# How often every lb-agent is polled and pages refresh (seconds): the default;
# the owner can change it at runtime in Owner -> Live updates.
PROXY_POLL_SECONDS=10
# One-time import from Orbit v0: its PROXIES JSON fills an EMPTY registry at
# start-up (tokens are sealed on the way in). Remove it after the first start;
# afterwards proxies are managed in Admin -> Proxies.
#   PROXIES=[{"name":"gmr","label":"GMR","agent":"http://gmr:9000","token":"...","lb_url":"http://gmr:80"}]
# TLS towards agents with an https:// URL (optional; http:// agents need none).
# The CA that signed the agents' certificates, added to the system's:
#   AGENT_CA_FILE=/certs/agents-ca.pem
# Orbit's client certificate, for agents that require one (mutual TLS).
# The key may come through SECRETS_BACKEND as AGENT_CLIENT_KEY instead (Vault).
#   AGENT_CLIENT_CERT_FILE=/certs/orbit-client.pem
#   AGENT_CLIENT_KEY_FILE=/certs/orbit-client.key
# The CA that signed PKI Management's HTTPS certificate (Proxies -> Certificates
# issues from it; its URL and API token are set on that page):
#   PKI_CA_FILE=/certs/pki-ca.pem

# --- Observability / updates ---
# Prometheus endpoint at /metrics (keep it behind your proxy).
METRICS_ENABLED=false
# Also send every audit entry to syslog / your SIEM as JSON: host:514 (UDP) or /dev/log.
#   SYSLOG_ADDR=siem.example.org:514
# About + "newer release?" check; set false to disable, REPO_URL to point elsewhere.
UPDATE_CHECK=true
#   REPO_URL=https://gitea.ubonito.org/jteixeira/Orbit

# SSO (OIDC), notifications, the webhook and security policy are configured on
# the page (Owner area) and stored sealed — nothing to set here.
